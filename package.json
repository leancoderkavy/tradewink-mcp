{
  "name": "@tradewink/mcp",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Tradewink signals for AI agents; pair with Alpaca MCP for paper-trading execution",
  "keywords": [
    "tradewink",
    "mcp",
    "mcp-server",
    "signals",
    "alpaca",
    "agent",
    "paper-trading",
    "trading",
    "ai",
    "llm",
    "stocks",
    "crypto"
  ],
  "license": "MIT",
  "author": "Tradewink <hello@tradewink.com>",
  "homepage": "https://tradewink.com",
  "type": "module",
  "bin": {
    "tradewink-mcp": "bin/cli.cjs",
    "tradewink-mcp-setup": "bin/setup.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/setup.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leancoderkavy/tradewink-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/leancoderkavy/tradewink-mcp/issues"
  }
}
